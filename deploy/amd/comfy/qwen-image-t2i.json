{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "TODO-verify: Qwen-Image diffusion model filename on the PC" },
    "inputs": { "unet_name": "qwen_image_fp8_e4m3fn.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "TODO-verify: Qwen2.5-VL text encoder filename" },
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "TODO-verify: Qwen-Image VAE filename" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "TODO-verify: shift value from the by-hand test" },
    "inputs": { "model": ["1", 0], "shift": 3.1 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "positive — the job's prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{prompt}}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "negative — the job's negative prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{negativePrompt}}" }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "size — the job's width × height" },
    "inputs": { "width": {{width}}, "height": {{height}}, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "TODO-verify: steps/cfg/sampler from the by-hand test" },
    "inputs": {
      "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
      "seed": {{seed}}, "steps": 20, "cfg": 2.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "output — the png the daemon downloads from /view" },
    "inputs": { "images": ["9", 0], "filename_prefix": "agenthub" }
  }
}
