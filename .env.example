# Reference for the env vars the hub reads — the hub does NOT load .env; set these in your shell or
# launchd unit. Every value here is optional; the defaults shown are what the hub uses.

# --- hub ---------------------------------------------------------------------
PORT=4000
HUB_DB=data/hub.db
PROJECTS_ROOT=data/projects

# --- auth --------------------------------------------------------------------
# With HUB_PASSWORD set, every /api route and the /ws upgrade needs the owner session cookie the UI
# gets from POST /api/login (30 days, HttpOnly) — except POST /api/login and GET /api/health.
# Daemon-facing routes (node registration and heartbeat, the job claim/log/complete/fail reports)
# also take `Authorization: Bearer $DAEMON_TOKEN`, which is how each node daemon calls the hub
# (`hubToken` in its config, or this same env var). Without HUB_PASSWORD the hub is open to anyone
# who can reach it — local dev only. HUB_SESSION_SECRET signs the session cookie; without one a
# random key is used and every hub restart logs you out. Reading the node list and driving the
# browser relay are the owner's alone, not the token's, and five failed logins from one address
# lock that address out of POST /api/login for 15 minutes.
HUB_PASSWORD=
HUB_SESSION_SECRET=
DAEMON_TOKEN=

# --- assistant ---------------------------------------------------------------
# Git-versioned memory bundle: MEMORY.md, notes/, planner/.
MEMORY_ROOT=data/memory

# --- telegram ----------------------------------------------------------------
# Both are required for the bot to start; with either missing the hub logs one line and runs
# without Telegram. Token from @BotFather. TELEGRAM_OWNER_CHAT_ID is your own Telegram *user* id
# (ask @userinfobot in a private chat) — the id of your private chat with the bot, not a group id.
# A negative value is a group id: the hub rejects it and starts without Telegram. See
# deploy/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Local-time HH:MM. CHECKIN_TIMES is a comma-separated list.
BRIEFING_TIME=08:00
CHECKIN_TIMES=13:00,18:00
