# Copy to configs/hub.env (gitignored) — sourced by .claude/launch.json before starting the dev hub.
# The hub never loads .env files itself; in production set these in the launchd/systemd unit.
PORT=4000
# Cloud tiers (either or both). Local nodes are preferred; cloud is the fallback or a per-project choice.
FIREWORKS_API_KEY=
#FIREWORKS_ORCHESTRATOR_MODEL=accounts/fireworks/models/glm-5p3-flash
#FIREWORKS_WORKER_MODEL=accounts/fireworks/models/glm-5p3-flash
# Expensive tier (GLM 5.3, Kimi K3). Off unless set; on, they appear in the project model picker.
#FIREWORKS_HARD_MODELS=1
#ANTHROPIC_API_KEY=
#CLOUD_ANTHROPIC=1
# A turn is cut short after this long; local models need more than the old 20.
#TURN_TIMEOUT_MINUTES=45
# Dollars of cloud spend allowed per trailing 24h; reached, cloud models go off until it falls below.
#MAX_CLOUD_USD_PER_DAY=5
# Fine-grained GitHub token for "Import a repo": needed for a private repo and for pushing back.
#GITHUB_TOKEN=
# The registered GitHub App behind "Connect GitHub" — a member connects with a button instead of
# minting a token (docs/guide.md → Operating the hub). All five or none; the last is the PATH to
# the .pem, not its contents, and the hub reads it at startup.
#GITHUB_APP_ID=
#GITHUB_APP_CLIENT_ID=
#GITHUB_APP_CLIENT_SECRET=
#GITHUB_APP_SLUG=
#GITHUB_APP_PRIVATE_KEY=configs/github-app.pem
# JD's web door (the JD page): JD's tailnet address, and the same token as JD_WEB_TOKEN in
# ~/telegramManager/.env (openssl rand -hex 32). Both or neither — docs/guide.md → Talking to JD in the hub.
#JD_URL=http://127.0.0.1:8891
#JD_WEB_TOKEN=
