# Copy to configs/hub.env (gitignored) — sourced by .claude/launch.json before starting the dev hub.
# The hub never loads .env files itself; in production set these in the launchd/systemd unit.
PORT=4000
# Cloud tiers (either or both). Local nodes are preferred; cloud is the fallback or a per-project choice.
FIREWORKS_API_KEY=
#FIREWORKS_ORCHESTRATOR_MODEL=accounts/fireworks/models/glm-5p3
#FIREWORKS_WORKER_MODEL=accounts/fireworks/models/glm-5p3-flash
#ANTHROPIC_API_KEY=
#CLOUD_ANTHROPIC=1
