{
  "name": "agenthub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/mocks && tsc --noEmit -p packages/hub && tsc --noEmit -p packages/node-daemon",
    "dev:hub": "tsx packages/hub/src/main.ts",
    "dev:node": "tsx packages/node-daemon/src/main.ts configs/dev-node.yaml"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
