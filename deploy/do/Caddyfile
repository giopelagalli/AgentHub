# AgentHub public edge — DigitalOcean droplet, on the tailnet.
#
# The droplet is stateless: it holds no data, no API keys and no database. Its
# only job is to terminate TLS for the public domain, demand a second factor
# before anything is forwarded, and reverse-proxy to the *current* control node
# over Tailscale. Everything it needs comes from /etc/caddy/agenthub.env
# (see deploy/do/README.md):
#
#   HUB_DOMAIN     rosenroot.com            the public name (apex; www redirects to it)
#   HUB_UPSTREAM   spark-f9a9.tail7ac2e2.ts.net:4000   the hub's tailnet name (see README §6)
#   ACME_EMAIL     you@example.com          Let's Encrypt contact
#   EDGE_USER      owner                    basic-auth user
#   EDGE_HASH      $2a$14$...               `caddy hash-password` output
#
# Reload after editing either file:  sudo systemctl reload caddy
{
	email {$ACME_EMAIL}
	# The droplet must never answer on its IP or on a name we did not configure:
	# an unmatched Host gets a connection close, not a certificate.
	servers {
		strict_sni_host on
	}
}

{$HUB_DOMAIN} {
	encode zstd gzip

	# The second factor for *browsers*. The hub's own login is one password on a
	# machine that holds the owner's memory, projects and API keys; basic auth
	# in front of the UI keeps scanners and login-throttle spam off it. It does
	# NOT cover the machine paths: /api/* (daemons and JD authenticate with
	# bearer tokens; the browser's own /api calls carry the hub's session
	# cookie), /install.sh and /install/* (the node installer; the source
	# tarball is gated by an enrollment token on the hub side) and /v1/* (the
	# OpenAI-compatible door, bearer-authenticated). Generate the hash with
	# `caddy hash-password`; never put a plaintext password here.
	@ui not path /api/* /install.sh /install/* /v1/*
	basic_auth @ui {
		{$EDGE_USER} {$EDGE_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# The hub's WebSocket (/ws) needs no special block: Caddy v2's reverse_proxy
	# passes Upgrade/Connection through and streams bidirectionally by default.
	# Same for the headers the hub's auth depends on — X-Forwarded-For,
	# X-Forwarded-Proto and X-Forwarded-Host are set automatically, which is why
	# the hub must run with TRUST_PROXY set (see README).
	reverse_proxy {$HUB_UPSTREAM} {
		# A video job's clip comes back through here; don't buffer it in RAM.
		flush_interval -1
		# A control-node switch takes the upstream down for a few seconds. Fail
		# fast and say so rather than hanging the browser for a minute.
		transport http {
			dial_timeout 5s
		}
		header_up X-Real-IP {remote_host}
	}

	# Caddy raises 502/503/504 itself when it can't reach the upstream (dial
	# failure, timeout, no healthy upstream) — not a status the hub returned
	# on its own. Machine paths get a bare 503; everything else gets the
	# offline page, also 503 so monitors and browsers both see an outage,
	# not a live 200. `route` keeps this in the order written: Caddy's
	# default directive sort would otherwise run the unconditional rewrite
	# before the matched respond, so @machine would never see its own path.
	handle_errors 502 503 504 {
		route {
			@machine path /api/* /install.sh /install/* /v1/*
			respond @machine "hub unavailable" 503

			root * /etc/caddy/site
			rewrite * /offline.html
			file_server {
				status 503
			}
		}
	}

	# One request per client identity is not worth logging a body for; keep the
	# access log to what an incident actually needs.
	log {
		output file /var/log/caddy/agenthub.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# The bare www name only redirects; the certificate for it is free.
www.{$HUB_DOMAIN} {
	redir https://{$HUB_DOMAIN}{uri} permanent
}
