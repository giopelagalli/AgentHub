# Copy to .env and fill in. Every value here is optional; the defaults shown are what the hub uses.

# --- hub ---------------------------------------------------------------------
PORT=4000
HUB_DB=data/hub.db
PROJECTS_ROOT=data/projects

# --- assistant ---------------------------------------------------------------
# Git-versioned memory bundle: MEMORY.md, notes/, planner/.
MEMORY_ROOT=data/memory

# --- telegram ----------------------------------------------------------------
# Both are required for the bot to start; with either missing the hub logs one line and runs
# without Telegram. Token from @BotFather; chat id is your own — see deploy/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Local-time HH:MM. CHECKIN_TIMES is a comma-separated list.
BRIEFING_TIME=08:00
CHECKIN_TIMES=13:00,18:00
