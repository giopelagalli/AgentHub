# Reference for the env vars the hub reads — the hub does NOT load .env; set these in your shell or
# launchd unit. Every value here is optional; the defaults shown are what the hub uses.

# --- hub ---------------------------------------------------------------------
PORT=4000
# The address the hub binds. 0.0.0.0 (the default) is right for local dev; on a
# deployed control node set it to that machine's tailnet IP so the hub is not
# listening on every interface the box has. See deploy/controlnode.md.
HUB_HOST=0.0.0.0
# The one directory the hub owns — the SQLite DB, project bundles, the memory
# bundle and the browser recordings. Set it and HUB_DB/PROJECTS_ROOT/MEMORY_ROOT
# and the recordings root all default to paths beneath it. It is also what a
# control-node switch copies: without it, /api/controlnode answers 501.
DATA_ROOT=
# The node this hub runs on, so it can't offer itself as its own switch target.
# A daemon that starts the hub sets this from its own node.name.
CONTROL_NODE_NAME=
HUB_DB=data/hub.db
PROJECTS_ROOT=data/projects

# --- auth --------------------------------------------------------------------
# With HUB_PASSWORD set, every /api route and the /ws upgrade needs the owner session cookie the UI
# gets from POST /api/login (30 days, HttpOnly) — except POST /api/login and GET /api/health.
# Daemon-facing routes (node registration and heartbeat, the job claim/log/complete/fail reports)
# also take `Authorization: Bearer $DAEMON_TOKEN`, which is how each node daemon calls the hub
# (`hubToken` in its config, or this same env var). Without HUB_PASSWORD the hub is open to anyone
# who can reach it — local dev only. HUB_SESSION_SECRET signs the session cookie; without one a
# random key is used and every hub restart logs you out. Reading the node list and driving the
# browser relay are the owner's alone, not the token's, and five failed logins from one address
# lock that address out of POST /api/login for 15 minutes.
HUB_PASSWORD=
HUB_SESSION_SECRET=
DAEMON_TOKEN=
# Set TRUST_PROXY only when the hub sits behind the DigitalOcean Caddy proxy (deploy/do/README.md):
# the droplet's tailnet IP (or a CIDR/comma-separated list), or `1` to trust any proxy — which is
# only safe if nothing but that proxy can reach :4000. It makes the login throttle count the real
# client from X-Forwarded-For instead of locking every visitor out on one attacker's failures, and
# marks the session cookie Secure when X-Forwarded-Proto says https. Unset, X-Forwarded-* is ignored.
TRUST_PROXY=

# --- assistant ---------------------------------------------------------------
# Git-versioned memory bundle: MEMORY.md, notes/, planner/.
MEMORY_ROOT=data/memory

# --- telegram ----------------------------------------------------------------
# Both are required for the bot to start; with either missing the hub logs one line and runs
# without Telegram. Token from @BotFather. TELEGRAM_OWNER_CHAT_ID is your own Telegram *user* id
# (ask @userinfobot in a private chat) — the id of your private chat with the bot, not a group id.
# A negative value is a group id: the hub rejects it and starts without Telegram. See
# deploy/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Local-time HH:MM. CHECKIN_TIMES is a comma-separated list.
BRIEFING_TIME=08:00
CHECKIN_TIMES=13:00,18:00

# --- cloud tier (no local GPU) ------------------------------------------------
# CLOUD_ANTHROPIC=1 registers the synthetic always-online node `cloud-anthropic`
# and serves the orchestrator and worker tiers with Claude through the Anthropic
# SDK, so the hub runs with no GPU node at all. Credentials are the SDK's own:
# ANTHROPIC_API_KEY, or an `ant auth login` profile — the hub never reads a key.
# Local nodes, when online, are still preferred for their tiers. See the README.
CLOUD_ANTHROPIC=
# Optional model overrides (defaults: claude-opus-4-8, claude-sonnet-5).
CLOUD_ORCHESTRATOR_MODEL=
CLOUD_WORKER_MODEL=

# Fireworks AI is the second cloud provider: OpenAI-compatible, one bearer token.
# Setting the key registers the synthetic node `cloud-fireworks` and serves the
# orchestrator and worker tiers from it (CLOUD_FIREWORKS=1 registers it without a
# key, which just logs one line and skips the node until the key is there).
FIREWORKS_API_KEY=
# Optional model overrides. The defaults follow Fireworks' documented
# accounts/<account>/models/<model> naming but are UNVERIFIED — `GET /api/models`
# lists what the account can actually serve, and the UI's Models picker uses it.
# Defaults: accounts/fireworks/models/glm-5p3, accounts/fireworks/models/glm-5p3-flash.
FIREWORKS_ORCHESTRATOR_MODEL=
FIREWORKS_WORKER_MODEL=

# --- external APIs (the only calls that leave the machine) ---------------------
# Each key that is absent removes its tool from every agent's belt, with one log line at startup.
# See deploy/external-apis.md for the endpoints and how to get each key.
XAI_API_KEY=
# X (Twitter) API v2 token for post_to_x. Without it, XAI_API_KEY is tried instead.
X_API_KEY=
GEMINI_API_KEY=
# brave | tavily
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
# Optional model overrides (defaults: grok-4, gemini-2.5-flash).
XAI_MODEL=
GEMINI_MODEL=
