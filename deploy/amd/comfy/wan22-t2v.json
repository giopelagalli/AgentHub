{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "TODO-verify: Wan 2.2 diffusion model filename (TI2V-5B fits the 7900 XTX)" },
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "TODO-verify: UMT5-XXL text encoder filename" },
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "TODO-verify: Wan 2.2 VAE filename" },
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "TODO-verify: shift value from the by-hand test" },
    "inputs": { "model": ["1", 0], "shift": 8.0 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "positive — the job's prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{prompt}}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "negative — the job's negative prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{negativePrompt}}" }
  },
  "7": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "size and length — width × height, length = seconds × fps as 4k+1 frames" },
    "inputs": { "vae": ["3", 0], "width": {{width}}, "height": {{height}}, "length": {{frames}}, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "TODO-verify: steps/cfg/sampler from the by-hand test" },
    "inputs": {
      "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
      "seed": {{seed}}, "steps": 30, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "CreateVideo",
    "_meta": { "title": "frames to a clip at the job's fps" },
    "inputs": { "images": ["9", 0], "fps": {{fps}} }
  },
  "11": {
    "class_type": "SaveVideo",
    "_meta": { "title": "TODO-verify: output — the mp4 the daemon downloads from /view" },
    "inputs": { "video": ["10", 0], "filename_prefix": "agenthub", "format": "mp4", "codec": "h264" }
  }
}
